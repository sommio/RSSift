{
  "name": "api",
  "private": true,
  "scripts": {
    "db:generate": "prisma generate --config ./prisma.config.ts",
    "db:deploy": "prisma migrate deploy --config ./prisma.config.ts",
    "db:migrate": "prisma migrate dev --config ./prisma.config.ts",
    "db:reset": "prisma migrate reset --config ./prisma.config.ts --force",
    "db:seed": "prisma db execute --config ./prisma.config.ts --file ./prisma/seed/seed.sql",
    "db:studio": "prisma studio --config ./prisma.config.ts",
    "dev": "nest start --watch",
    "prebuild": "pnpm db:generate",
    "build": "nest build",
    "start": "nest start",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/src/main.js",
    "prelint": "pnpm db:generate",
    "lint": "eslint . --max-warnings 0",
    "pretypecheck": "pnpm db:generate",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "pretest": "pnpm db:generate",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest --config ./jest.config.ts",
    "pretest:e2e": "pnpm db:generate",
    "test:e2e": "NODE_OPTIONS=--experimental-vm-modules jest --config ./e2e/jest-e2e.json"
  },
  "dependencies": {
    "@mozilla/readability": "0.6.0",
    "@nestjs/common": "^11.1.18",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "^11.1.18",
    "@nestjs/platform-express": "^11.1.18",
    "@prisma/adapter-pg": "7.7.0",
    "@prisma/client": "7.7.0",
    "escape-html": "^1.0.3",
    "feedsmith": "2.9.2",
    "jsdom": "26.1.0",
    "openai": "^6.34.0",
    "pg": "8.20.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "turndown": "7.2.4",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@jest/globals": "^30.3.0",
    "@nestjs/cli": "^11.0.18",
    "@nestjs/schematics": "^11.0.10",
    "@nestjs/testing": "^11.1.18",
    "@repo/eslint-config": "workspace:*",
    "@repo/jest-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/express": "^5.0.6",
    "@types/jsdom": "^28.0.1",
    "@types/node": "^25.5.2",
    "@types/pg": "8.15.5",
    "@types/supertest": "^7.2.0",
    "@types/turndown": "^5.0.6",
    "eslint": "^9.39.4",
    "jest": "^30.3.0",
    "prisma": "7.7.0",
    "source-map-support": "^0.5.21",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.9",
    "ts-loader": "^9.5.7",
    "tsconfig-paths": "^4.2.0",
    "typescript": "6.0.2"
  }
}
