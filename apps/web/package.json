{
  "name": "web",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "predev": "pnpm --filter @repo/ui build",
    "dev": "NEXT_TELEMETRY_DISABLED=1 next dev --turbopack --port 3001",
    "prebuild": "pnpm --filter @repo/ui build",
    "build": "NEXT_TELEMETRY_DISABLED=1 next build",
    "start": "NEXT_TELEMETRY_DISABLED=1 next start --port 3001",
    "lint": "eslint . --max-warnings 0",
    "pretypecheck": "pnpm --filter @repo/ui build",
    "typecheck": "tsc --noEmit",
    "pretest": "pnpm --filter @repo/ui build",
    "test": "jest --config ./jest.config.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@repo/ui": "workspace:*",
    "next": "16.2.2",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@jest/globals": "^30.3.0",
    "@playwright/test": "^1.59.1",
    "@repo/eslint-config": "workspace:*",
    "@repo/jest-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@tailwindcss/postcss": "4.2.2",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.5.2",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "^9.39.4",
    "jest": "^30.3.0",
    "jest-environment-jsdom": "^30.3.0",
    "postcss": "8.5.9",
    "tailwindcss": "4.2.2",
    "ts-node": "^10.9.2",
    "typescript": "6.0.2"
  }
}
