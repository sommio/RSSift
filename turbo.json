{
  "$schema": "https://turborepo.dev/schema.json",
  "globalDependencies": [
    "**/.env.*local",
    "apps/api/.env.example",
    "apps/api/feeds.opml.example",
    "apps/web/.env.example"
  ],
  "globalEnv": [
    "API_BASE_URL",
    "CI",
    "DATABASE_URL",
    "FEED_OPML_PATH",
    "INGEST_ON_BOOT",
    "NO_COLOR",
    "PORT",
    "TEST_DATABASE_URL"
  ],
  "ui": "tui",
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "lint": {
      "dependsOn": ["^build", "^lint"],
      "outputs": []
    },
    "typecheck": {
      "dependsOn": ["^build", "^typecheck"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test:e2e": {
      "dependsOn": ["build"],
      "outputs": []
    }
  }
}
