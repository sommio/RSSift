{
  "$schema": "https://turborepo.dev/schema.json",
  "globalDependencies": [
    "**/.env.*local",
    "apps/api/.env.example",
    "apps/api/feeds.opml.example",
    "apps/web/.env.example"
  ],
  "globalEnv": [
    "API_BASE_URL",
    "CI",
    "DATABASE_URL",
    "FEED_AUTO_REFRESH_INTERVAL_HOURS",
    "FEED_MAX_ARTICLES_PER_FEED",
    "FEED_OPML_PATH",
    "INGEST_ON_BOOT",
    "LLM_API_KEY",
    "LLM_BASE_URL",
    "LLM_MODEL",
    "LLM_SUMMARY_CONCURRENCY",
    "LLM_SUMMARY_LANGUAGE",
    "LLM_TIMEOUT_MS",
    "NO_COLOR",
    "PORT",
    "TEST_DATABASE_URL"
  ],
  "ui": "tui",
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "contract:refresh": {
      "cache": false
    },
    "lint": {
      "dependsOn": ["^build", "^lint"],
      "outputs": []
    },
    "typecheck": {
      "dependsOn": ["^build", "^typecheck"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test:e2e": {
      "dependsOn": ["build"],
      "outputs": []
    }
  }
}
