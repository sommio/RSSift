{
  "name": "rssift",
  "version": "0.1.0",
  "private": true,
  "description": "Minimalist RSS summary reader using LLMs for layered gists. Focuses on scanning essence without full-text overhead.",
  "author": "sommio",
  "license": "MIT",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "prepare": "husky .husky",
    "typecheck": "turbo run typecheck",
    "test": "pnpm test:root && turbo run test --ui=stream",
    "test:root": "node --test .github/scripts/*.test.mjs",
    "test:e2e": "turbo run test:e2e --concurrency=1",
    "lint": "pnpm lint:root && turbo run lint",
    "lint:staged": "lint-staged",
    "lint:root": "eslint --max-warnings 0 eslint.config.mjs .prettierrc.mjs .github/scripts",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "eslint": "catalog:",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "0.0.0-insiders.f7d2598",
    "turbo": "^2.9.6",
    "typescript": "6.0.3"
  },
  "packageManager": "pnpm@10.33.2+sha512.a90faf6feeab71ad6c6e57f94e0fe1a12f5dcc22cd754db40ae9593eb6a3e0b6b12e3540218bb37ae083404b1f2ce6db2a4121e979829b4aff94b99f49da1cf8",
  "engines": {
    "node": ">=24.14.1"
  }
}
